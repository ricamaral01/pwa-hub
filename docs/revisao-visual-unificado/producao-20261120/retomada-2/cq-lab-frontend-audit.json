  "unchanged_cq_client_pdf_calls": [
    "async function preview(){try{const id=await save();if(!id)return;window.open(`./api/certificados/${id}/pdf`,'_blank','noopener')}catch(e){notice(e.message,true)}}",
    "$('preview').addEventListener('click',preview);",
    "async function loadHistory(){try{const rows=await api('certificados?q='+encodeURIComponent($('search').value));const el=$('history');el.replaceChildren();if(!rows.length)el.textContent='Nenhum certificado encontrado.';for(const row of rows){const line=document.createElement('div'),info=document.createElement('div'),actions=document.createElement('div'),badge=document.createElement('span');const label=row.liberacao_excepcional_por?'liberado':row.status;badge.className='badge '+label;badge.textContent=label;const title=document.createElement('strong');title.textContent=`${row.numero||'Rascunho #'+row.id} · ${row.cliente}`;const meta=document.createElement('small');meta.textContent=`${br(row.data_emissao)} · revisão ${row.revisao} · `;meta.append(badge);info.append(title,meta);const open=document.createElement('button');open.className='secondary';open.textContent='Abrir';open.addEventListener('click',()=>openCert(row.id));actions.append(open);if(row.status!=='legado'){const pdf=document.createElement('button');pdf.className='secondary';pdf.textContent='PDF';pdf.addEventListener('click',()=>window.open(`./api/certificados/${row.id}/pdf`,'_blank','noopener'));actions.append(pdf)}if(row.status==='emitido'&&config.can_correct){const revise=document.createElement('button');revise.className='secondary';revise.textContent='Nova revisão';revise.addEventListener('click',async()=>{try{const result=await api(`certificados/${row.id}/revisar`,{method:'POST',body:'{}'});await openCert(result.id);notice('Nova revisão criada como rascunho.')}catch(e){notice(e.message,true)}});actions.append(revise)}line.append(info,actions);el.append(line)}}catch(e){notice(e.message,true)}}"
  ],
