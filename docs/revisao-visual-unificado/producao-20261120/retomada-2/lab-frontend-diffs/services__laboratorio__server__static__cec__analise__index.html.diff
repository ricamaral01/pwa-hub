+@media screen{:root{--primary:var(--c-blue);--primary-light:var(--c-blue);--accent:var(--c-orange);--card-bg:rgba(0,0,0,0.04);--card-border:rgba(0,0,0,0.10);--text:var(--c-navy);--muted:var(--c-ink-2);--radius:var(--r);--shadow:0 8px 28px rgba(0,0,0,0.12);}
+*{margin:0;padding:0;box-sizing:border-box;}
+body{background:var(--c-surface);color:var(--text);min-height:100vh;display:flex;flex-direction:column;}
+/* ── TOP BAR ── */
+.topbar{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;background:rgba(255,255,255,0.92);border-bottom:1px solid var(--card-border);backdrop-filter:blur(10px);position:sticky;top:0;z-index:50;}
+.topbar-brand{display:flex;align-items:center;gap:14px;}
+.topbar-brand img{height:40px;width:40px;object-fit:contain;border-radius:var(--r);}
+.topbar-brand .brand-name{font-size:1rem;font-weight:900;letter-spacing:.04em;line-height:1.1;}
+.topbar-brand .brand-name span{color:var(--accent);}
+.topbar-brand .brand-sub{font-size:.65rem;color:var(--muted);text-transform:none;letter-spacing:.06em;margin-top:2px;}
+.btn-back{display:inline-flex;align-items:center;gap:6px;background:rgba(0,0,0,0.07);border:1px solid rgba(0,0,0,0.18);border-radius:var(--r);color:var(--text);font-size:.85rem;font-weight:700;padding:8px 16px;text-decoration:none;transition:background .15s, transform .1s;}
+.btn-back:hover{background:rgba(0,0,0,0.12);transform:none;}
+/* ── HERO ── */
+.hero{text-align:center;padding:44px 20px 32px;}
+.hero-icon{font-size:3rem;display:inline-flex;align-items:center;justify-content:center;width:80px;height:80px;border-radius:var(--r);background:var(--c-surface);box-shadow:none;margin-bottom:18px;}
+.hero h1{font-size:1.6rem;font-weight:900;letter-spacing:.02em;margin-bottom:8px;}
+.hero h1 span{color:var(--accent);}
+.hero p{font-size:.9rem;color:var(--muted);max-width:480px;margin:0 auto;line-height:1.55;}
+.accent-line{width:60px;height:3px;background:var(--accent);border-radius:var(--r);margin:16px auto 0;}
+/* ── MAIN ── */
+main{flex:1;padding:0 20px 60px;max-width:760px;width:100%;margin:0 auto;}
+/* ── SECTION LABEL ── */
+.section-label{font-size:.7rem;font-weight:800;text-transform:none;letter-spacing:1.2px;color:var(--muted);margin:32px 0 14px;display:flex;align-items:center;gap:10px;}
+.section-label::after{content:"";flex:1;height:1px;background:var(--card-border);}
+/* ── UNIT GRID ── */
+.unit-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(170px, 1fr));gap:16px;}
+/* ── UNIT CARD ── */
+.unit-card{background:var(--card-bg);border:1px solid var(--card-border);border-radius:var(--r);padding:24px 16px 20px;display:flex;flex-direction:column;align-items:center;gap:12px;text-decoration:none;color:var(--text);cursor:pointer;transition:background .15s, transform .12s, box-shadow .15s, border-color .15s;position:relative;overflow:hidden;}
+.unit-card::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--c-surface);opacity:0;transition:opacity .2s;}
+.unit-card:hover{background:rgba(0,0,0,0.06);transform:none;box-shadow:none;border-color:rgba(0,0,0,0.18);}
+.unit-card:hover::before{opacity:1;}
+.unit-icon{width:56px;height:56px;border-radius:var(--r);background:rgba(26,58,92,0.18);display:flex;align-items:center;justify-content:center;font-size:1.7rem;flex-shrink:0;}
+.unit-icon img{width:100%;height:100%;object-fit:contain;}
+.unit-name{font-size:.95rem;font-weight:800;text-align:center;line-height:1.2;}
+.unit-desc{font-size:.72rem;color:var(--muted);text-align:center;line-height:1.35;}
+/* ── FOOTER ── */
+.page-footer{text-align:center;font-size:.68rem;color:var(--muted);opacity:.5;padding:20px 20px 32px;}
+@media (max-width: 480px){.unit-grid{grid-template-columns:repeat(2, 1fr);}
+.hero h1{font-size:1.3rem;}
+}
+/* ── MOBILE: ocultar card desktop-only ── */
+@media (max-width: 768px){.desktop-only{display:none!important;}
+}
+/* ── INSTALL BUTTON ── */
+.btn-install{display:none;align-items:center;gap:8px;background:var(--c-surface);border:none;border-radius:var(--r);color:var(--c-surface);font-size:.85rem;font-weight:800;padding:9px 18px;cursor:pointer;box-shadow:none;transition:transform .1s, box-shadow .15s;}
+.btn-install:hover{transform:none;box-shadow:none;}
+.btn-install.visible{display:inline-flex;}
+}
