+.storagecard p{color:var(--c-ink-3);line-height:1.7;font-size:11px;}
+.footer{display:flex;justify-content:space-between;color:var(--c-ink-3);font-size:10px;padding:21px 0 2px;gap:15px;}
+.view{display:none;}
+.view.active{display:block;}
