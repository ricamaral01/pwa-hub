+
+}
+@media screen{:root{--bg:var(--c-bg);--nav:var(--c-navy);--ink:var(--c-navy);--muted:var(--c-ink-3);--border:var(--c-line);--teal:var(--c-ok);--soft:var(--c-line-2);--t1:var(--c-orange);--t2:var(--c-orange);--t3:var(--c-ink-3);--t4:var(--c-ink-2);--radius:var(--r);}
