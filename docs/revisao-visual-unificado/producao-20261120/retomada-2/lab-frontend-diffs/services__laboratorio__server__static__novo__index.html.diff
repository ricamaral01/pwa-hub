+.eventrow strong{font-size:11px;display:block;}
+.eventrow p{font-size:10px;color:var(--muted);margin-top:5px;line-height:1.5;}
+.eventrow .eventtime{margin-left:auto;font-size:11px;white-space:nowrap;color:var(--c-ink-2);}
+.storagecard{padding:21px;background:var(--c-line-2);border-color:var(--c-line);}
