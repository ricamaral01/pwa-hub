+.divider{height:1px;background:var(--border);margin:22px 0;}
+.settingstat{display:flex;justify-content:space-between;padding:13px 0;font-size:12px;border-bottom:1px solid var(--c-line-2);gap:20px;}
+.settingstat span{color:var(--muted);}
+.settingstat b{text-align:right;font-weight:600;}
+.pinlist{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:17px 0;}
+.pin{padding:12px 5px;background:var(--c-bg);border-radius:var(--r);text-align:center;font-size:10px;color:var(--muted);}
+.pin b{display:block;font-size:16px;color:var(--ink);margin-top:4px;}
