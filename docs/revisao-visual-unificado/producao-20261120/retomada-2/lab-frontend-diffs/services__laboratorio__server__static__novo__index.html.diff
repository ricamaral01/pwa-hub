+body{margin:0;background:var(--bg);color:var(--ink);font-size:15px;}
+button,input,select{font:inherit;}
+button{cursor:pointer;}
+button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--c-ink-3);outline-offset:3px;}
+button:disabled{opacity:.55;cursor:wait;}
+button,input,select{border:1px solid var(--border);border-radius:var(--r);}
+button{background:white;color:var(--ink);padding:10px 15px;font-weight:600;}
+button:hover{background:var(--c-line-2);}
+input,select{padding:11px 12px;background:white;color:var(--ink);width:100%;min-height:44px;}
+label{display:block;color:var(--c-ink-2);font-size:13px;font-weight:600;margin-bottom:7px;}
+h1,h2,h3,p{margin:0;}
+h1{font-size:29px;letter-spacing:-.8px;}
+h2{font-size:18px;}
+h3{font-size:15px;}
+.app{min-height:100vh;display:grid;grid-template-columns:216px 1fr;}
+.sidebar{background:var(--nav);color:white;display:flex;flex-direction:column;padding:30px 16px;position:fixed;width:216px;inset:0 auto 0 0;z-index:20;}
+.brand{display:flex;align-items:center;gap:10px;padding:0 10px;}
+.brand-mark{background:var(--c-ok);border:1px solid var(--c-ink-2);width:34px;height:37px;border-radius:var(--r);display:grid;place-items:center;font-size:25px;font-weight:700;}
+.brand strong{font-size:18px;letter-spacing:-.5px;}
+.brand small{display:block;font-size:9px;letter-spacing:2.1px;color:var(--c-ink-3);margin-top:4px;}
+.navlabel{color:var(--c-ink-3);font-size:10px;letter-spacing:1.8px;margin:44px 13px 13px;}
+.nav{display:flex;flex-direction:column;gap:7px;}
+.nav button{background:transparent;color:var(--c-ink-3);border:0;text-align:left;padding:13px 15px;display:flex;align-items:center;gap:11px;font-size:13px;}
+.nav button.active{background:var(--c-blue);color:var(--c-surface);box-shadow:none;}
+.nav button:hover{background:var(--c-blue);}
+.nav svg{width:18px;height:18px;flex-shrink:0;}
+.sidebottom{margin-top:auto;border-top:1px solid var(--c-blue);padding:22px 11px 0;}
+.sidebottom small{color:var(--c-ink-3);line-height:1.7;font-size:11px;}
+.sidebottom strong{display:block;font-size:12px;margin-bottom:5px;}
+.main{grid-column:2;min-width:0;}
+.topbar{height:74px;background:var(--c-surface);border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;padding:0 32px;gap:12px;}
+.crumb{font-size:12px;color:var(--muted);}
+.crumb strong{color:var(--ink);font-weight:500;}
+.user{display:flex;gap:14px;align-items:center;font-size:12px;}
+.avatar{width:32px;height:32px;background:var(--c-line-2);display:grid;place-items:center;border-radius:50%;color:var(--c-ink-2);font-weight:700;}
+.content{padding:29px 32px 22px;max-width:1600px;margin:auto;}
+.heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;gap:15px;}
+.section-context{font-size:10px;color:var(--teal);letter-spacing:2px;font-weight:700;margin-bottom:8px;}
+.sub{font-size:12px;color:var(--muted);line-height:1.7;margin-top:7px;}
+.actions{display:flex;gap:9px;}
+.btn-primary{background:var(--teal);color:var(--c-surface);border-color:var(--teal);}
+.btn-primary:hover{background:var(--c-blue);}
+.badge{display:inline-flex;align-items:center;gap:6px;border-radius:var(--r);padding:6px 9px;font-size:10px;line-height:1.2;font-weight:600;background:var(--soft);color:var(--c-ok);white-space:nowrap;}
+.badge.amber{background:var(--c-bg);color:var(--c-warn);}
+.badge.red{background:var(--c-bg);color:var(--c-crit);}
+.dot{width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block;}
+.notice{background:var(--c-bg);border:1px solid var(--c-line);color:var(--c-warn);font-size:12px;border-radius:var(--r);padding:11px 14px;line-height:1.5;margin-bottom:20px;display:none;}
+.notice.show{display:block;}
+.contextbar{background:var(--c-surface);border:1px solid var(--border);border-radius:var(--r);padding:15px 18px;margin-bottom:20px;display:flex;align-items:center;gap:20px;flex-wrap:wrap;}
+.contextbar .item{font-size:11px;color:var(--muted);border-right:1px solid var(--border);padding-right:22px;}
+.contextbar .item strong{display:block;font-size:12px;color:var(--ink);margin-top:5px;font-weight:600;}
+.contextbar .status{margin-left:auto;}
+.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:21px;}
+.card{background:white;border:1px solid var(--border);border-radius:var(--r);}
+.sensor{padding:19px 20px 15px;position:relative;overflow:hidden;}
+.sensor:before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--c);}
+.sensorhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:19px;}
+.channel{font-size:10px;background:color-mix(in srgb,var(--c) 12%,white);color:var(--c);padding:5px 7px;border-radius:var(--r);font-weight:700;}
+.sensorhead strong{font-size:12px;margin-left:7px;}
+.sensorhead svg{color:var(--c);width:17px;height:17px;}
+.value{font-size:39px;line-height:1;letter-spacing:-1.2px;font-weight:650;}
+.value span{font-size:19px;color:var(--c-ink-3);font-weight:400;margin-left:3px;letter-spacing:0;}
+.sensorfoot{font-size:10px;color:var(--muted);display:flex;justify-content:space-between;gap:8px;margin-top:18px;}
+.sensorfoot b{font-weight:500;color:var(--c-ink-2);}
+.middle{display:grid;grid-template-columns:minmax(0,1fr) 274px;gap:19px;margin-bottom:20px;}
+.chartcard{padding:21px 21px 12px;min-width:0;}
+.cardhead{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:17px;}
+.cardhead p{color:var(--muted);font-size:11px;margin-top:6px;}
+.segments{display:flex;border:1px solid var(--border);border-radius:var(--r);padding:3px;}
+.segments button{padding:6px 9px;border:0;font-size:10px;background:transparent;}
+.segments button.active{background:var(--c-line-2);color:var(--c-blue);}
+.legend{display:flex;gap:17px;flex-wrap:wrap;margin-top:4px;margin-bottom:4px;}
+.legend button{border:0;padding:3px 0;font-size:10px;font-weight:500;background:none;display:flex;align-items:center;gap:5px;}
+.legend button.off{opacity:.35;}
+.legend i{width:15px;height:3px;border-radius:var(--r);display:block;}
+.plot{position:relative;min-height:260px;touch-action:pan-y;}
+.plot svg{width:100%;height:292px;display:block;overflow:visible;}
+.plot text{fill:var(--c-ink-3);font-size:10px;}
+.tooltip{display:none;position:absolute;pointer-events:none;z-index:10;background:var(--c-blue);color:white;box-shadow:none;border-radius:var(--r);padding:12px;font-size:11px;line-height:1.8;min-width:165px;}
+.chartnote{display:flex;justify-content:space-between;border-top:1px solid var(--c-line-2);padding-top:10px;color:var(--muted);font-size:10px;gap:15px;line-height:1.6;}
+.summary{padding:22px;display:flex;flex-direction:column;gap:19px;}
+.summary h2{font-size:15px;}
+.metric{padding-bottom:17px;border-bottom:1px solid var(--border);}
+.metric:last-of-type{border:0;padding-bottom:0;}
