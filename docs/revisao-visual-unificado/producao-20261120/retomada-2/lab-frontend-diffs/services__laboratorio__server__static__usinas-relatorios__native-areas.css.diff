+@media screen {
+.native-wrap{padding:22px 24px 28px;}
+.native-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:24px;}
+.native-tab{display:flex;align-items:center;gap:13px;min-height:93px;text-align:left;border:1px solid var(--c-line);border-radius:var(--r);background:var(--c-surface);color:var(--c-blue);padding:17px 19px;box-shadow:none;}
+.native-tab::before{content:"▣";display:grid;place-items:center;flex:0 0 44px;height:44px;border-radius:var(--r);background:var(--c-orange);color:var(--c-surface);font-size:1.25rem;}
+.native-tab:nth-child(3n/**/+2)::before{background:var(--c-blue);}
+.native-tab:nth-child(3n)::before{background:var(--c-ink-2);}
+.native-tab strong,.native-tab small{display:block;}
+.native-tab strong{font-size:.95rem;}
+.native-tab small{margin-top:5px;color:var(--c-ink-2);font-size:.75rem;line-height:1.4;font-weight:500;}
+.native-tab:hover,.native-tab:focus-visible,.native-tab[aria-selected="true"]{border-color:var(--c-ok);outline:none;box-shadow:none;}
+.native-head{display:flex;justify-content:space-between;gap:16px;align-items:start;margin-bottom:18px;}
+.native-head h3{margin:0;font-size:1.35rem;}
+.native-head p{margin:6px 0 0;color:var(--c-ink-2);font-size:.88rem;}
+.native-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:14px 0;}
+.native-field{display:grid;gap:6px;color:var(--c-ink-2);font-size:.78rem;font-weight:700;}
+.native-field input,.native-field select{width:100%;padding:10px 11px;border:1px solid var(--c-line);border-radius:var(--r);background:var(--c-surface);color:var(--c-navy);font:inherit;font-size:.9rem;}
+.native-actions{display:flex;flex-wrap:wrap;gap:8px;margin:15px 0 20px;}
+.native-primary{border:1px solid var(--c-ok);border-radius:var(--r);padding:10px 16px;background:var(--c-ok);color:var(--c-surface);font-weight:800;}
+.native-primary:hover{background:var(--c-blue);}
+.native-secondary{border:1px solid var(--c-line);border-radius:var(--r);padding:10px 14px;background:var(--c-surface);color:var(--c-blue);font-weight:700;}
+.native-secondary:hover{background:var(--c-line-2);}
+.native-status{padding:12px 14px;border-radius:var(--r);background:var(--c-bg);color:var(--c-ink-2);font-size:.85rem;line-height:1.45;}
+.native-status.error{background:var(--c-bg);color:var(--c-warn);}
+.native-login{max-width:460px;border:1px solid var(--c-line);border-radius:var(--r);padding:18px;background:var(--c-surface);margin-bottom:18px;}
+.native-login h4{margin:0 0 8px;}
+.native-login p{font-size:.84rem;color:var(--c-ink-2);line-height:1.5;}
+.native-result{margin-top:20px;}
+.native-result h4{margin:17px 0 8px;font-size:1rem;}
+.native-result .scroll{border:1px solid var(--c-line);border-radius:var(--r);}
+.native-result table{min-width:560px;}
+.native-result td{white-space:normal;vertical-align:top;}
+.native-result .native-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-bottom:12px;}
+.native-result .native-card{border:1px solid var(--c-line);background:var(--c-surface);border-radius:var(--r);padding:13px;}
+.native-card span{display:block;color:var(--c-ink-2);font-size:.75rem;}
+.native-card strong{display:block;margin-top:5px;overflow-wrap:anywhere;}
+@media (max-width:1000px){.native-tabs{grid-template-columns:repeat(2,minmax(0,1fr));}
+}
+@media (max-width:700px){.native-wrap{padding:16px;}
+.native-tabs{grid-template-columns:1fr;}
+.native-head{display:block;}
+.native-actions{display:grid;grid-template-columns:1fr 1fr;}
+}
+@media print{body{background:#fff}.native-tabs,.native-actions,.native-login,.legacy-grid,.native-status{display:none!important}.native-wrap{padding:0}.native-result .scroll{overflow:visible}.native-result table{min-width:0}}
