+.absorption-history .panelHead{align-items:center;gap:14px;flex-wrap:wrap}.abs-history-filters{display:flex;align-items:end;gap:12px;flex-wrap:wrap;margin:16px 0}.abs-history-filters .field{min-width:170px}.abs-history-filters strong{margin-left:auto;font-size:13px;color:var(--muted)}.abs-history-table-wrap{overflow:auto;max-height:620px;border:1px solid var(--line-2);border-radius:8px}.abs-history-table{width:100%;min-width:1050px;border-collapse:collapse;font-size:12px}.abs-history-table th,.abs-history-table td{padding:8px 10px;border-bottom:1px solid var(--line-2);text-align:center;white-space:nowrap}.abs-history-table th{position:sticky;top:0;z-index:1;background:var(--raised);font-weight:700}.abs-history-table tr.abs-group-start td{border-top:2px solid var(--accent)}.abs-history-table tbody tr:hover{background:var(--accent-soft)}.absorption-history>.note:last-child{margin-top:13px}
