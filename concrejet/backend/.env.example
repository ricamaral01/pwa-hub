# Copie para backend/.env ao rodar a API localmente (fora do docker-compose).
# Nunca commitar o arquivo .env com segredos reais.

NODE_ENV=development
PORT=3000

# Use 5433 se o Postgres vier do docker-compose (ver DATABASE_HOST_PORT em ../.env.example);
# use 5432 apenas se for um Postgres local nativo, fora do Docker.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=concretrack
DATABASE_PASSWORD=changeme
DATABASE_NAME=concretrack_injecao
DATABASE_SSL=false

JWT_SECRET=changeme-generate-a-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_COOKIE_NAME=concretrack_session

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

LOG_LEVEL=info

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
