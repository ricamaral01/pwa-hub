# Copie este arquivo para .env e preencha com valores reais.
# Nunca commitar o arquivo .env com segredos reais.

NODE_ENV=development
PORT=3000

# DATABASE_PORT é a porta usada por ferramentas rodando no host (migrations, seed,
# npm run start:dev fora do container) para falar com o Postgres do docker-compose.
# DATABASE_HOST_PORT é a porta do HOST mapeada para o container (padrão 5433, não
# 5432, para não colidir com um PostgreSQL nativo que já esteja rodando na máquina).
# As duas devem ter o mesmo valor. Dentro da rede do docker-compose (container "api"
# falando com o container "postgres") a porta continua sendo sempre 5432.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_HOST_PORT=5433
DATABASE_USER=concretrack
DATABASE_PASSWORD=changeme
DATABASE_NAME=concretrack_injecao
DATABASE_SSL=false

# Gere um valor forte, ex.: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_COOKIE_NAME=concretrack_session

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

LOG_LEVEL=info

# Usadas apenas pelo script de seed (npm run seed:admin). Não preencher em produção
# sem necessidade; se SEED_ADMIN_PASSWORD ficar vazio, uma senha é gerada e impressa uma única vez.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
