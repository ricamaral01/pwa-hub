[Unit]
Description=Mapa de Concretagem Photo API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/mapa-photo-api/current
Environment=PORT=5000
Environment=PHOTO_STORAGE_DIR=/opt/mapaproducao-storage
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/mapaproducao-storage

[Install]
WantedBy=multi-user.target
