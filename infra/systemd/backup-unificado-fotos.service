[Unit]
Description=Backup diario das fotos isoladas do Mapa unificado
After=mapa-unificado-auth.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/concrefer-unificado/photo-storage
ExecStart=/usr/bin/python3 /opt/concrefer-unificado/infra/backup_unificado_fotos.py --restore-check
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/concrefer-unificado-fotos
