[Unit]
Description=ConcreTrack Unified API (FastAPI/Uvicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/concrefer-unificado/hub-api
EnvironmentFile=/etc/concrefer-unificado/hub.env
ExecStart=/opt/concrefer-unificado/hub-api/.venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8015
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
