[Unit]
Description=Monitora serviços e disco do sistema unificado
After=network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/python3 /opt/concrefer-unificado/infra/monitor_unificado.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/concrefer-unificado-monitor
