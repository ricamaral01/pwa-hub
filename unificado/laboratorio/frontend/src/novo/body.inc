  if(loading)return <PreviewShell area="postes" page="Carregando" active="ensaio"><div className="authShell">Carregando…</div></PreviewShell>;
  if(!user)return <PreviewShell area="postes" page="Acesso" active="ensaio"><div className="authShell"><form className="loginCard" onSubmit={doLogin}><div className="eyebrow">CONCRETRACK · LABORATÓRIO</div><h1>Entrar na aplicação</h1><p>Use seu usuário e senha para acessar ensaios e monitoramento.</p><Input label="Usuário" value={login.username} onChange={v=>setLogin({...login,username:v})}/><label className="field"><span>Senha</span><input className="input" type="password" value={login.password} onChange={e=>setLogin({...login,password:e.target.value})}/></label>{loginError&&<p className="warning">{loginError}</p>}<button className="btn primary" type="submit">Entrar</button></form></div></PreviewShell>;
  const phaseNames=['Identificação','Inspeção','Ensaio mecânico','Resultado'];
  const linkedAbsorption=absSheets.find(row=>row.dados.numero_amostra.trim()&&row.dados.numero_amostra.trim()===form.numero_amostra.trim());
  const photoPanel=<PhotoPanel testId={testId} inspection={result.inspecao} steps={result.etapas} save={async()=>{if(currentStatus!=='finalizado')await saveDraft();return idRef.current}} notify={notify}/>;
  return <PreviewShell area="postes" page={tab==='ensaio'?'Ensaio de postes':tab==='absorcao'?'Ensaio de absorção':tab==='historico'?'Histórico':'Cadastros'} active={tab} user={`${user.username} · ${user.role}`} role={user.role} context={<><span className="preview-chip">NBR 8451-1 · -2 · -3 · -4</span><span className="preview-chip">FL-PRO-22 · Rev. 00</span></>} onLogout={async()=>{await api('/api/auth/logout',{method:'POST'});setUser(null)}} onCriteria={()=>{setDraftCriteria(structuredClone(criteria));setDrawer(true)}}>
    {message&&<div className="toast" role="status">{message}</div>}
    {tab==='ensaio'&&<div className="pv-pole-page"><div className="pv-page-heading"><div><div className="eyebrow">NBR 8451-1 · 8451-2 · 8451-3</div><h1>Ensaio de postes</h1><p>Identifique a amostra, inspecione, registre as leituras e revise o resultado.</p></div><span className="chip">Amostra {form.numero_amostra||'—'} · {saving?'Salvando…':currentStatus}</span></div>
      <div className="pv-progress"><nav className="pv-phases" aria-label="Passos do ensaio">{phaseNames.map((name,index)=>{const status=index===0?(form.numero_amostra.trim()?'PREENCHIDO':'PENDENTE'):index===1?(result.inspecao?.status||'PENDENTE'):index===2?(Object.values(result.etapas).some(item=>item.status==='FORA')?'FORA':Object.values(result.etapas).every(item=>item.status==='DENTRO'||item.status==='N/A')?'DENTRO':'PENDENTE'):result.veredito;return <button key={name} className={phase===index?'active':''} aria-current={phase===index?'step':undefined} onClick={()=>setPhase(index)}><span>{index+1}</span><span className="pv-phase-label">{name}<small>{status}</small></span></button>})}</nav>
      <div className="pv-phase-summary"><strong>Passo {phase+1} de 4 · {phaseNames[phase]}</strong><span>{form.poste.tipo} {nf(form.poste.altura_m)} m / {nf(form.poste.resistencia_daN,0)} daN · {form.poste.tipo==='C'?'seção circular':`Face ${form.poste.face}`}</span><Pill status={result.veredito}/></div></div>
      {phase===0&&<><div className="pv-step-content">__ROW1__</div><div className="pv-step-actions"><button className="btn" onClick={()=>void saveDraft()}>Salvar rascunho</button><button className="btn primary" onClick={()=>{void saveDraft();setPhase(1)}}>Salvar e avançar</button></div></>}
      {phase===1&&<><div className="pv-step-content">__INSPECTION__{photoPanel}</div><div className="pv-step-actions"><button className="btn" onClick={()=>setPhase(0)}>Voltar</button><button className="btn" onClick={()=>void saveDraft()}>Salvar rascunho</button><button className="btn primary" onClick={()=>{void saveDraft();setPhase(2)}}>Salvar e avançar</button></div></>}
      {phase===2&&<><div className="pv-mechanical"><div className="pv-mechanical-nav"><strong>Sequência de ensaio</strong>{steps.map((label,index)=><button key={label} className={step===index?'active':''} onClick={()=>setStep(index)}><span>{index+1}. {label}</span><Pill status={result.etapas[`e${index+1}`].status}/></button>)}</div><div className="pv-mechanical-main"><div className="panel"><div className="panelHead"><div><div className="eyebrow">NBR 8451-3</div><h2>{steps[step]}</h2></div><span className="note">Leitura registrada na bancada</span></div>{stage()}<div className="pv-stage-actions"><button className="btn" onClick={()=>document.getElementById('pv-photos')?.scrollIntoView({behavior:'smooth'})}>Anexar foto (opcional)</button><button className="btn primary" onClick={()=>{void saveDraft();setStep(s=>Math.min(4,s+1))}}>Registrar e avançar</button></div></div><div id="pv-photos">{photoPanel}</div></div></div><div className="pv-step-actions"><button className="btn" onClick={()=>setPhase(1)}>Voltar</button><button className="btn primary" onClick={()=>setPhase(3)}>Ver resultado</button></div></>}
      {phase===3&&<><div className="pv-result-grid"><div className="pv-result-main">__VERDICT__<div className="panel pv-abs-link"><div className="eyebrow">NBR 8451-4</div><h2>Ensaio de absorção</h2>{linkedAbsorption?<p>Ensaio salvo para a amostra {form.numero_amostra}: <Pill status={linkedAbsorption.resultados.status}/></p>:<p>Nenhum ensaio de absorção salvo com o número desta amostra.</p>}<a className="btn" href={linkedAbsorption?`/novo/postes?tab=absorcao&sheet=${linkedAbsorption.id}`:'/novo/postes?tab=absorcao'}>{linkedAbsorption?'Abrir ensaio de absorção':'Abrir módulo de absorção'}</a></div></div><aside className="pv-result-side"><div className="panel"><div className="eyebrow">Critérios aplicados</div><h2>Versão {activeRecord?.criterios_snapshot?'do registro':criteriaVersion}</h2><p className="note">O resultado usa os critérios associados ao ensaio. O histórico mantém as versões anteriores.</p></div></aside></div><div className="panel pv-recent"><div className="panelHead"><h2>Amostras ensaiadas</h2><button className="btn" onClick={exportXlsx}>Exportar planilha</button></div><History rows={history.slice(0,10)} open={openRecord} print={r=>report(r,'print')}/><button className="btn" onClick={()=>setTab('historico')}>Ver histórico completo</button></div><div className="pv-step-actions"><button className="btn" onClick={()=>setPhase(2)}>Voltar</button></div></>}
    </div>}
    {tab==='absorcao'&&<PreviewAbsorptionModule notify={notify} initialId={new URLSearchParams(location.search).get('sheet')}/>}
    __HISTORY__
    __CADASTROS__
    <footer className="foot">Concretrack · Ensaio de postes · FL-PRO-22 <span>Critério vigente v{criteriaVersion} · usuário {user.username}</span></footer>
    __DRAWER__
  </PreviewShell>;
}
