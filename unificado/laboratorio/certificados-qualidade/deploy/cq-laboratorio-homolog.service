[Unit]
Description=Certificados de qualidade do Laboratorio (homologacao)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=monitorconcreto
Group=monitorconcreto
WorkingDirectory=/opt/concrefer-unificado/homolog/cq
EnvironmentFile=/etc/concrefer-unificado/laboratorio-homolog.env
Environment=CQ_DATA_DIR=/opt/concrefer-unificado/homolog/data/cq
Environment=CQ_ALLOWED_ORIGIN=https://concrefer.concretrack.com.br:18446
Environment=CQ_VERIFY_BASE=https://concrefer.concretrack.com.br:18446
Environment=CQ_LOGO_PATH=/opt/concrefer-unificado/homolog-next/public/unificado/assets/img/logo-concrefer.png
Environment=CQ_REVISION_USER_IDS=user-ricardo,user-ricardo-do-amaral,alex,user-alex,philippe,marcelo
Environment="CQ_VALIDATION_NOTICE=Fonte histórica indisponível para validação completa: 8 certificados antigos, somente 1 par comparável. Uso restrito à homologação."
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/monitor_concreto/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 13075 --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/concrefer-unificado/homolog/data/cq
UMask=0077

[Install]
WantedBy=multi-user.target
