[Unit]
Description=Certificados de qualidade do Laboratorio
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=monitorconcreto
Group=monitorconcreto
WorkingDirectory=/opt/concrefer-unificado/cq
EnvironmentFile=/etc/concrefer-unificado/laboratorio.env
Environment=CQ_DATA_DIR=/var/lib/concrefer-cq
Environment=CQ_ALLOWED_ORIGIN=https://concrefer.concretrack.com.br
Environment=CQ_VERIFY_BASE=https://concrefer.concretrack.com.br
Environment=CQ_LOGO_PATH=/opt/concrefer-unificado/public/unificado/assets/img/logo-concrefer.png
Environment=CQ_REVISION_USER_IDS=user-ricardo,user-ricardo-do-amaral,alex,user-alex,philippe,marcelo
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/monitor_concreto/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 13074 --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/concrefer-cq
UMask=0077

[Install]
WantedBy=multi-user.target
