[Unit]
Description=Qualidade do Unificado (API isolada)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=qualidade
Group=qualidade
WorkingDirectory=/opt/qualidade/service
EnvironmentFile=/etc/qualidade/service.env
EnvironmentFile=/etc/qualidade/gateway.env
ExecStart=/opt/qualidade/.venv/bin/uvicorn quality.main:app --host 127.0.0.1 --port 13066 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qualidade

[Install]
WantedBy=multi-user.target
