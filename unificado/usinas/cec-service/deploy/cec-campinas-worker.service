[Unit]
Description=CEC Campinas analytics worker on the new VPS
After=postgresql.service cec-campinas-api.service
Requires=postgresql.service

[Service]
Type=simple
User=cec-campinas
Group=cec-campinas
WorkingDirectory=/opt/concrefer-unificado/cec-campinas
EnvironmentFile=/etc/concrefer/cec-campinas.env
ExecStart=/usr/bin/node /opt/concrefer-unificado/cec-campinas/src/workers/analytics_worker.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
