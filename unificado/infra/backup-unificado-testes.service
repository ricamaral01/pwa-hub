[Unit]
Description=Backup horario dos bancos do unificado
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
WorkingDirectory=/var/lib/postgresql
ExecStart=/usr/bin/python3 /opt/concrefer-unificado/infra/backup_unificado_testes.py --restore-check
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/concrefer-unificado
