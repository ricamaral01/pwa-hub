BEGIN;
ALTER TABLE maodeobra_dias ADD COLUMN IF NOT EXISTS salvo_em timestamptz NULL;
ALTER TABLE maodeobra_dias ADD COLUMN IF NOT EXISTS salvo_por_usuario_id integer NULL;
ALTER TABLE maodeobra_dias ADD COLUMN IF NOT EXISTS motivo_sem_producao varchar(255) NULL;
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'fk_maodeobra_dias_salvo_por_usuario') THEN
    ALTER TABLE maodeobra_dias
      ADD CONSTRAINT fk_maodeobra_dias_salvo_por_usuario
      FOREIGN KEY (salvo_por_usuario_id) REFERENCES usuarios(id) ON DELETE SET NULL;
  END IF;
END $$;
COMMIT;
