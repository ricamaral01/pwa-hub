+      <CalcField label="Massa" value={part.mass == null ? '—' : formatNumero(part.mass, 1)} unit="kg/m³"/>
+    </div>)}
+  </div>; })}</div>;
+}
+function CostInput({ label, value, onChange }: { label: string; value: number; onChange: (n: number) => void }) {
