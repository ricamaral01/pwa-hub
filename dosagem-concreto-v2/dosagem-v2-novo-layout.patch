('/traco/')?(active?<Editor initial={active} onPersist={persist} status={status} statusMessage={message}/>:<EmptyState title="Traço não encontrado" description="Volte à lista de traços." action={<Button onClick={()=>navigate('/tracos')}>Ver traços</Button>}/>):path==='/materiais'?<MateriaisPage/>:path==='/fornecedores'?<FornecedoresPage/>:path==='/ensaios'?<EnsaiosPage/>:path==='/ferramentas'?<FerramentasPage/>:path==='/custos'?<CustosPage/>:path==='/referencia'?<ReferenciaPage/>:path==='/producao-r1'?<ProducaoRelease1/>:path==='/importacao-r1'?<ImportacaoRelease1/>:path==='/config'?<ConfigPage preference={preference} setPreference={setPreference}/>:<Home tracos={tracos} onNew={onNew} onOpen={onOpen}/>}</AppLayout>; }
+export function App() { return <HashRouter><InnerApp/></HashRouter>; }
