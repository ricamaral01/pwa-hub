FROM nginx:1.27-alpine
RUN apk add --no-cache openssl && mkdir -p /etc/nginx/hml
RUN openssl req -x509 -newkey rsa:2048 -nodes -days 7 -subj "/CN=localhost" \
    -keyout /etc/nginx/hml/key.pem -out /etc/nginx/hml/cert.pem
COPY deploy/hml/nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html
