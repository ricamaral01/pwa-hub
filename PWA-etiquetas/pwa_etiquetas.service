[Unit]
Description=ConcreTrack — Etiquetas de Corpo de Prova (porta 5050)
After=network.target postgresql.service

[Service]
Type=simple
ExecStart=/usr/local/bin/gunicorn --workers 2 --bind 0.0.0.0:5050 app:app
WorkingDirectory=/root/PWA-etiquetas
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
