[Unit]
Description=One-time local Dosagem administrator password reset
After=postgresql.service
ConditionPathExists=/opt/concretrack-dosagem/shared/ricardo-password-reset.hash

[Service]
Type=oneshot
User=ctdosagem
Group=ctdosagem
WorkingDirectory=/opt/concretrack-dosagem/current/api
EnvironmentFile=/opt/concretrack-dosagem/shared/.env
Environment=PYTHONPATH=/opt/concretrack-dosagem/current/api:/opt/concretrack-dosagem/current/api/vendor
ExecStart=/opt/concretrack-dosagem/current/api/.venv/bin/python -m app.reset_local_password --email ricardo.rda@gmail.com --hash-file /opt/concretrack-dosagem/shared/ricardo-password-reset.hash
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=/opt/concretrack-dosagem/shared

