[Unit]
Description=Audit 24-hour Supabase legacy mirror observation
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/concrefer-unificado/migration/supabase-sync
ExecStart=/usr/bin/python3 /opt/concrefer-unificado/migration/supabase-sync/acceptance.py
ExecStart=/usr/bin/python3 /opt/concrefer-unificado/migration/supabase-sync/sync.py --dry-run
ExecStart=/usr/bin/python3 /opt/concrefer-unificado/migration/supabase-sync/audit.py
TimeoutStartSec=180
